# ============================================================================
# PRISM — Pull Request Intelligence & Review Mesh
# Environment configuration. NEVER commit a real .env file.
# Every variable is optional: with nothing configured PRISM runs in DEMO MODE
# (clearly labeled) using bundled fixtures and the local deterministic analyzer.
# ============================================================================

# ---- RUNTIME ---------------------------------------------------------------
NODE_ENV=development
# Secret used to sign dashboard session cookies. Generate: openssl rand -hex 32
PRISM_SESSION_SECRET=change-me-in-production
# Database file (SQLite). For production use Postgres (see README -> Deploy).
PRISM_DATABASE_PATH=./data/prism.sqlite
# demo | live  — DEMO MODE never mixes fixture data with connected repositories
PRISM_MODE=demo
# Public base URL of the deployment, used for GitHub webhook callback URLs
PRISM_BASE_URL=http://localhost:3000

# ---- DATABASE (production Postgres is supported via the same DAL; SQLite by default) ----
DATABASE_URL=

# ---- REDIS / QUEUE (optional: when unset, the durable in-process queue is used) ----
REDIS_URL=

# ---- GITHUB APP ------------------------------------------------------------
# App ID from https://github.com/settings/apps
GITHUB_APP_ID=
# PEM contents may be provided as a single-line \n-escaped string or a file path
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# Webhook secret configured on the GitHub App; required to verify webhook signatures
GITHUB_WEBHOOK_SECRET=
# OAuth (for dashboard login with GitHub identity)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- AI PROVIDERS ----------------------------------------------------------
# At least one provider enables LLM agents. Without a key, PRISM uses the
# LOCAL deterministic analyzer — agents still run, findings are rule-based.
# OpenAI-compatible (OpenAI, Together, Groq, OpenRouter, local vLLM/Ollama...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Provider routing preference: auto | openai | gemini | anthropic | local
PRISM_AI_PROVIDER=auto

# ---- REVIEW POLICY DEFAULTS ------------------------------------------------
PRISM_REVIEW_MODE=standard        # fast | standard | deep | security | test
PRISM_MAX_AI_TOKENS=120000
PRISM_AI_COST_BUDGET_USD=2.00

# ---- OBSERVABILITY ---------------------------------------------------------
LOG_LEVEL=info                    # debug | info | warn | error
PRISM_RETENTION_DAYS=90

# ---- SANDBOX / STATIC TOOLS (optional; missing tools are detected & skipped)
PRISM_TOOL_TIMEOUT_MS=60000
SEMGRIPE_BIN=semgrep
ESLINT_BIN=eslint
